# Environment
ENVIRONMENT=development

# Database
POSTGRES_USER=fabbi
POSTGRES_PASSWORD=fabbi_secret
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://fabbi:fabbi_secret@localhost:5432/postgres
# Echo every SQL statement to stdout. Leave off outside of debugging: it logs
# row data and costs throughput.
DB_ECHO=false

# Redis
REDIS_PASSWORD=fabbi_redis_secret
REDIS_URL=redis://:fabbi_redis_secret@localhost:6379/0

# JWT
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this value when ENVIRONMENT=production.
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: explicit browser origins, comma separated. "*" is rejected.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (build-time: Vite inlines it)
VITE_API_URL=http://localhost:8000

# Published host ports. Change these if something already owns the default.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional seed sizes
SEED_USERS=100
SEED_TODOS=1000
